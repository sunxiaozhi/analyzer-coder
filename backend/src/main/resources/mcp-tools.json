[
  {
    "name": "review_change",
    "title": "Review a real code change",
    "description": "Runs the same immutable Git change review as the HTTP API. Requires repository READ permission.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "已认证的代码知识平台账户可见的仓库 UUID"
        },
        "task": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "changeSource": {
          "type": "string",
          "enum": [
            "WORKTREE",
            "SINGLE_COMMIT",
            "COMMIT_RANGE"
          ]
        },
        "baseRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "headRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "modelConfigId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeEvidence": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "repositoryId",
        "changeSource"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "get_task_context",
    "title": "Get Agent task context",
    "description": "Returns version-bound rules, obligations, unknowns, code facts, and retrieval leads.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "已认证的代码知识平台账户可见的仓库 UUID"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "taskReviewId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxItems": {
          "default": 12,
          "type": "integer",
          "minimum": 5,
          "maximum": 40
        },
        "maxChars": {
          "default": 12000,
          "type": "integer",
          "minimum": 4000,
          "maximum": 60000
        },
        "maxTokens": {
          "default": 3000,
          "type": "integer",
          "minimum": 500,
          "maximum": 15000
        },
        "includeContent": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "repositoryId",
        "task"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "get_rules_for_symbol",
    "title": "Get deterministic rules for a changed symbol",
    "description": "Projects only verified knowledge from an immutable task review; it never promotes retrieval matches.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "已认证的代码知识平台账户可见的仓库 UUID"
        },
        "reviewId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "includeEvidence": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "repositoryId",
        "reviewId",
        "symbol"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },

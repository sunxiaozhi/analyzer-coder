<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.analyzercoder.infrastructure.persistence.mapper.AuthMapper">
<resultMap id="account" type="com.analyzercoder.infrastructure.persistence.model.AuthAccountRow"><constructor><idArg column="id" javaType="java.util.UUID"/><arg column="username" javaType="string"/><arg column="display_name" javaType="string"/><arg column="password_hash" javaType="string"/><arg column="account_role" javaType="string"/><arg column="enabled" javaType="_boolean"/><arg column="must_change_password" javaType="_boolean"/><arg column="failed_attempts" javaType="_int"/><arg column="locked_until" javaType="java.time.Instant"/><arg column="temporary_password_expires_at" javaType="java.time.Instant"/><arg column="last_login_at" javaType="java.time.Instant"/><arg column="last_login_ip" javaType="string"/><arg column="created_at" javaType="java.time.Instant"/><arg column="updated_at" javaType="java.time.Instant"/></constructor></resultMap>
<resultMap id="session" type="com.analyzercoder.infrastructure.persistence.model.AuthSessionRow"><constructor><idArg column="token_hash" javaType="string"/><arg column="csrf_token" javaType="string"/><arg column="created_at" javaType="java.time.Instant"/><arg column="last_seen_at" javaType="java.time.Instant"/><arg column="expires_at" javaType="java.time.Instant"/><arg column="id" javaType="java.util.UUID"/><arg column="username" javaType="string"/><arg column="display_name" javaType="string"/><arg column="account_role" javaType="string"/><arg column="enabled" javaType="_boolean"/><arg column="must_change_password" javaType="_boolean"/><arg column="last_login_at" javaType="java.time.Instant"/></constructor></resultMap>
<resultMap id="summary" type="com.analyzercoder.infrastructure.persistence.model.AccountSummaryRow"><constructor><idArg column="id" javaType="java.util.UUID"/><arg column="username" javaType="string"/><arg column="display_name" javaType="string"/><arg column="account_role" javaType="string"/><arg column="enabled" javaType="_boolean"/><arg column="must_change_password" javaType="_boolean"/><arg column="locked_until" javaType="java.time.Instant"/><arg column="permission_count" javaType="_int"/><arg column="last_login_at" javaType="java.time.Instant"/><arg column="last_login_ip" javaType="string"/><arg column="created_at" javaType="java.time.Instant"/><arg column="updated_at" javaType="java.time.Instant"/></constructor></resultMap>
<sql id="accountColumns">id,username,display_name,password_hash,account_role,enabled,must_change_password,failed_attempts,locked_until,temporary_password_expires_at,last_login_at,last_login_ip,created_at,updated_at</sql><select id="accountCount" resultType="int">SELECT COUNT(*) FROM accounts</select><select id="findByUsername" resultMap="account">SELECT <include refid="accountColumns"/> FROM accounts WHERE LOWER(BTRIM(username))=LOWER(BTRIM(#{username}))</select><select id="findById" resultMap="account">SELECT <include refid="accountColumns"/> FROM accounts WHERE id=#{id}</select>
<sql id="summaryColumns">a.id,a.username,a.display_name,a.account_role,a.enabled,a.must_change_password,a.locked_until,CAST((SELECT COUNT(*) FROM repository_permissions p WHERE p.account_id=a.id) AS INTEGER) permission_count,a.last_login_at,a.last_login_ip,a.created_at,a.updated_at</sql><select id="listAccounts" resultMap="summary">SELECT <include refid="summaryColumns"/> FROM accounts a ORDER BY a.created_at,a.id</select><select id="summary" resultMap="summary">SELECT <include refid="summaryColumns"/> FROM accounts a WHERE a.id=#{id}</select><select id="enabledAdminCount" resultType="int">SELECT COUNT(*) FROM accounts WHERE account_role='SUPER_ADMIN' AND enabled=TRUE</select>
<insert id="insertAccount">INSERT INTO accounts(id,username,display_name,password_hash,account_role,enabled,must_change_password,failed_attempts,temporary_password_expires_at,created_at,updated_at) VALUES(#{id},#{username},#{displayName},#{passwordHash},#{role},TRUE,#{mustChange},0,#{expiresAt},#{now},#{now})</insert><update id="recordLoginFailure">UPDATE accounts SET failed_attempts=#{failures},locked_until=#{lockedUntil},updated_at=#{now} WHERE id=#{id}</update><update id="recordLoginSuccess">UPDATE accounts SET failed_attempts=0,locked_until=NULL,last_login_at=#{now},last_login_ip=#{sourceIp},updated_at=#{now} WHERE id=#{id}</update><update id="changePassword">UPDATE accounts SET password_hash=#{passwordHash},must_change_password=FALSE,temporary_password_expires_at=NULL,updated_at=#{now} WHERE id=#{id}</update><update id="updateAccount">UPDATE accounts SET display_name=#{displayName},account_role=#{role},enabled=#{enabled},updated_at=#{now} WHERE id=#{id}</update><update id="resetPassword">UPDATE accounts SET password_hash=#{passwordHash},must_change_password=TRUE,temporary_password_expires_at=#{expiresAt},failed_attempts=0,locked_until=NULL,updated_at=#{now} WHERE id=#{id}</update><update id="unlock">UPDATE accounts SET failed_attempts=0,locked_until=NULL,updated_at=#{now} WHERE id=#{id}</update>
<select id="findSession" resultMap="session">SELECT s.token_hash,s.csrf_token,s.created_at,s.last_seen_at,s.expires_at,a.id,a.username,a.display_name,a.account_role,a.enabled,a.must_change_password,a.last_login_at FROM login_sessions s JOIN accounts a ON a.id=s.account_id WHERE s.token_hash=#{tokenHash}</select><insert id="insertSession">INSERT INTO login_sessions(token_hash,account_id,csrf_token,created_at,last_seen_at,expires_at) VALUES(#{tokenHash},#{accountId},#{csrfToken},#{now},#{now},#{expiresAt})</insert><update id="touchSession">UPDATE login_sessions SET last_seen_at=#{now} WHERE token_hash=#{tokenHash}</update><delete id="deleteSession">DELETE FROM login_sessions WHERE token_hash=#{tokenHash}</delete><delete id="deleteAccountSessions">DELETE FROM login_sessions WHERE account_id=#{accountId}</delete>
<select id="permissions" resultType="map">SELECT p.repo_id,r.name,p.permission_level FROM repository_permissions p JOIN repositories r ON r.id=p.repo_id WHERE p.account_id=#{accountId} AND r.deleted_at IS NULL ORDER BY r.name,r.id</select><select id="audits" resultType="map">SELECT e.id,e.event_type,e.result,e.request_id,e.source_ip,e.created_at,actor.username actor_username,target.username target_username,r.name repository_name FROM audit_events e LEFT JOIN accounts actor ON actor.id=e.actor_account_id LEFT JOIN accounts target ON target.id=e.target_account_id LEFT JOIN repositories r ON r.id=e.target_repo_id ORDER BY e.created_at DESC,e.id DESC LIMIT #{limit} OFFSET #{offset}</select><insert id="insertAudit">INSERT INTO audit_events(id,actor_account_id,target_account_id,target_repo_id,event_type,result,request_id,source_ip,details,created_at) VALUES(#{id},#{actorId},#{targetId},#{repositoryId},#{eventType},#{result},#{requestId},#{sourceIp},'{}'::jsonb,#{createdAt})</insert>
</mapper>

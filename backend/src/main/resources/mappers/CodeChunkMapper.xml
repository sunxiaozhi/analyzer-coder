<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.analyzercoder.infrastructure.persistence.mapper.CodeChunkMapper">
  <resultMap id="row" type="com.analyzercoder.infrastructure.persistence.model.CodeChunkRow"><constructor><idArg column="id" javaType="java.util.UUID"/><arg column="repo_id" javaType="java.util.UUID"/><arg column="snapshot_id" javaType="java.util.UUID"/><arg column="commit_sha" javaType="java.lang.String"/><arg column="file_path" javaType="java.lang.String"/><arg column="symbol_id" javaType="java.lang.String"/><arg column="symbol_name" javaType="java.lang.String"/><arg column="symbol_kind" javaType="java.lang.String"/><arg column="language" javaType="java.lang.String"/><arg column="chunk_type" javaType="java.lang.String"/><arg column="start_line" javaType="java.lang.Integer"/><arg column="end_line" javaType="java.lang.Integer"/><arg column="content" javaType="java.lang.String"/><arg column="content_hash" javaType="java.lang.String"/><arg column="created_at" javaType="java.time.Instant"/></constructor></resultMap>
  <sql id="columns">id,repo_id,snapshot_id,commit_sha,file_path,symbol_id,symbol_name,symbol_kind,language,chunk_type,start_line,end_line,content,content_hash,created_at</sql>
  <delete id="deleteByRepositoryId">DELETE FROM code_chunks WHERE repo_id=#{repositoryId}</delete>
  <insert id="insertBatch">INSERT INTO code_chunks(<include refid="columns"/>) VALUES <foreach collection="rows" item="row" separator=",">(#{row.id},#{row.repositoryId},#{row.snapshotId},#{row.commitSha},#{row.filePath},#{row.symbolId},#{row.symbolName},#{row.symbolKind},#{row.language},#{row.chunkType},#{row.startLine},#{row.endLine},#{row.content},#{row.contentHash},#{row.createdAt})</foreach></insert>
  <sql id="filter"><if test="query != null and query != ''">AND(POSITION(LOWER(#{query}) IN LOWER(file_path))&gt;0 OR POSITION(LOWER(#{query}) IN LOWER(COALESCE(symbol_name,'')))&gt;0 OR POSITION(LOWER(#{query}) IN LOWER(COALESCE(symbol_kind,'')))&gt;0 OR POSITION(LOWER(#{query}) IN LOWER(COALESCE(language,'')))&gt;0 OR POSITION(LOWER(#{query}) IN LOWER(content))&gt;0)</if></sql>
  <select id="find" resultMap="row">SELECT <include refid="columns"/> FROM code_chunks WHERE repo_id=#{repositoryId} <include refid="filter"/> ORDER BY <if test="query != null and query != ''">CASE WHEN POSITION(LOWER(#{query}) IN LOWER(file_path))&gt;0 THEN 4 ELSE 0 END+CASE WHEN POSITION(LOWER(#{query}) IN LOWER(COALESCE(symbol_name,'')))&gt;0 THEN 3 ELSE 0 END+CASE WHEN POSITION(LOWER(#{query}) IN LOWER(COALESCE(symbol_kind,'')))&gt;0 THEN 2 ELSE 0 END+CASE WHEN POSITION(LOWER(#{query}) IN LOWER(COALESCE(language,'')))&gt;0 THEN 2 ELSE 0 END+CASE WHEN POSITION(LOWER(#{query}) IN LOWER(content))&gt;0 THEN 1 ELSE 0 END DESC,</if>file_path,start_line,id <if test="limit != null">LIMIT #{limit} OFFSET #{offset}</if></select>
  <select id="count" resultType="long">SELECT COUNT(*) FROM code_chunks WHERE repo_id=#{repositoryId} <include refid="filter"/></select>
</mapper>

<script setup lang="ts">
import type { AccountSummary } from '@/types/security';
defineProps<{ rows: AccountSummary[]; currentAccountId?: string }>();
const emit = defineEmits<{
  (event: 'toggle', account: AccountSummary): void;
  (event: 'reset', account: AccountSummary): void;
  (event: 'unlock', account: AccountSummary): void;
}>();
const labels: Record<string, string> = { ACTIVE: '正常', DISABLED: '已停用', LOCKED: '已锁定', PASSWORD_CHANGE_REQUIRED: '待修改密码' };
</script>
<template><el-table :data="rows"><el-table-column label="用户" min-width="190"><template #default="{row}"><div class="primary-cell"><b>{{row.displayName}}</b><span class="mono">{{row.username}}</span></div></template></el-table-column><el-table-column label="角色" width="120"><template #default="{row}"><el-tag effect="plain">{{row.role==='SUPER_ADMIN'?'管理员':'普通用户'}}</el-tag></template></el-table-column><el-table-column label="状态" width="140"><template #default="{row}"><el-tag effect="plain" :type="row.status==='ACTIVE'?'success':'warning'">{{labels[row.status]??row.status}}</el-tag></template></el-table-column><el-table-column prop="repositoryPermissionCount" label="仓库权限" width="110"/><el-table-column label="最近登录" min-width="170"><template #default="{row}">{{row.lastLoginAt?new Date(row.lastLoginAt).toLocaleString():'—'}}</template></el-table-column><el-table-column prop="lastLoginIp" label="最近 IP" width="145"/><el-table-column label="操作" width="260"><template #default="{row}"><el-button v-if="row.status==='LOCKED'" link type="primary" @click="emit('unlock',row)">解锁</el-button><el-button link type="primary" @click="emit('reset',row)">重置密码</el-button><el-button link :type="row.status==='DISABLED'?'success':'danger'" :disabled="row.id===currentAccountId" @click="emit('toggle',row)">{{row.status==='DISABLED'?'启用':'停用'}}</el-button></template></el-table-column></el-table></template>

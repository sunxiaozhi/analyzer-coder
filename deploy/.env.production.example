# Copy to .env.production, replace every placeholder, and protect the file with chmod 600.
POSTGRES_DB=codebase_kb
POSTGRES_USER=codebase_kb
POSTGRES_PASSWORD=replace-with-a-strong-database-password

APP_INITIAL_ADMIN_USERNAME=admin
APP_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password
APP_LLM_MASTER_KEY=replace-with-at-least-24-random-characters
APP_CREDENTIAL_MASTER_KEY=replace-with-a-different-32-byte-random-secret

APP_REPOSITORY_HOST_ROOT=/srv/analyzer-repositories
APP_MANAGED_DATA_HOST_ROOT=/var/lib/analyzer-coder
APP_RUNTIME_UID=10001
APP_RUNTIME_GID=10001
APP_HTTP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8088
APP_SESSION_COOKIE_SECURE=true
APP_LLM_ALLOW_INSECURE_LOCAL=false
CODEGRAPH_VERSION=1.5.0
TZ=Asia/Shanghai

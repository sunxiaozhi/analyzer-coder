HOME=/var/lib/analyzer-coder
APP_SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
APP_FORWARD_HEADERS_STRATEGY=framework
APP_SESSION_COOKIE_SECURE=true

APP_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/codebase_kb
APP_DATASOURCE_USERNAME=codebase_kb
APP_DATASOURCE_PASSWORD=replace-with-a-strong-database-password
APP_FLYWAY_ENABLED=true

APP_INITIAL_ADMIN_USERNAME=admin
APP_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password
APP_REPOSITORY_ALLOWED_ROOTS=/srv/analyzer-repositories
APP_MANAGED_DATA_ROOT=/var/lib/analyzer-coder
APP_CODEGRAPH_EXECUTABLE=/usr/local/bin/codegraph
APP_LLM_MASTER_KEY=replace-with-at-least-24-random-characters
APP_CREDENTIAL_MASTER_KEY=replace-with-a-different-32-byte-random-secret
APP_LLM_ALLOW_INSECURE_LOCAL=false

# Copy this file to .env on the deployment host. Match backend/config/application.yml.
# Single quotes preserve literal $ and # in Docker Compose values.
POSTGRES_IMAGE=pgvector/pgvector:pg17
NGINX_IMAGE=nginx:1.28-alpine
POSTGRES_DB=codebase_kb
POSTGRES_USER=codebase_kb
POSTGRES_PASSWORD='replace-with-database-password'
POSTGRES_PORT=5432
# Default: Docker-managed named volume. Preserve POSTGRES_VOLUME during upgrades.
POSTGRES_STORAGE_TYPE=volume
POSTGRES_DATA_SOURCE=postgres-data
POSTGRES_VOLUME=analyzer-coder-components_postgres-data
# To use a host directory, change STORAGE_TYPE to bind and DATA_SOURCE to an
# existing absolute path, such as /data/analyzer-coder/postgres or D:/apps/analyzer-coder/postgres.
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=8088
TZ=Asia/Shanghai

# Copy this file to .env on the deployment host. Match backend/config/application.yml.
# Single quotes preserve literal $ and # in Docker Compose values.
POSTGRES_IMAGE=pgvector/pgvector:pg17
NGINX_IMAGE=nginx:1.28-alpine
POSTGRES_DB=codebase_kb
POSTGRES_USER=codebase_kb
POSTGRES_PASSWORD='replace-with-database-password'
POSTGRES_PORT=18080
# PostgreSQL uses a bind mount only:
#   source = this absolute host path; create it before docker-compose up.
#   target = /var/lib/postgresql/data inside the container; fixed in compose.yaml, do not change it.
# Linux example below. On Windows use an absolute path such as D:/apps/analyzer-coder/postgres.
POSTGRES_DATA_SOURCE=/opt/sunhuanshi/analyzer-coder/postgres
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=18081
TZ=Asia/Shanghai

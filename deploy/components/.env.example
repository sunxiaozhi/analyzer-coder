# Copy to .env on the deployment host. Match backend/config/application.yml.
# Single quotes preserve literal $ and # in Docker Compose values.
POSTGRES_IMAGE=pgvector/pgvector:pg17
NGINX_IMAGE=nginx:1.28-alpine
POSTGRES_DB=codebase_kb
POSTGRES_USER=codebase_kb
POSTGRES_PASSWORD='replace-with-database-password'
POSTGRES_PORT=5432
POSTGRES_VOLUME=analyzer-coder-components_postgres-data
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=8088
TZ=Asia/Shanghai

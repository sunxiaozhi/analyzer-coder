# Generated as .env on first start. Values use Docker Compose env-file syntax.
ANALYZER_IMAGE=analyzer-coder:1.0.0
APP_HTTP_BIND_ADDRESS=0.0.0.0
APP_HTTP_PORT=18081
TZ=Asia/Shanghai
POSTGRES_DB=codebase_kb
POSTGRES_USER=codebase_kb
POSTGRES_PASSWORD=replace-with-database-password
APP_INITIAL_ADMIN_USERNAME=admin
# 8-64 characters, including uppercase, lowercase, number and special character.
APP_INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password
# Keep these independent keys unchanged when upgrading/restoring.
APP_LLM_MASTER_KEY=replace-with-independent-random-secret-at-least-32-characters
APP_CREDENTIAL_MASTER_KEY=replace-with-another-random-secret-at-least-32-characters
APP_SESSION_COOKIE_SECURE=false
APP_REPOSITORY_TRUSTED_PRIVATE_HOSTS=
APP_REPOSITORY_INSECURE_TLS_HOSTS=
# JVM startup options; apply changes with analyzer.sh/ps1 restart.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=40.0
